# Copy this file to .env and fill in your own values. .env is gitignored.

# From console.cognodb.com after creating your free instance
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=<the password shown once during instance creation>

# Optional: enables AI-generated incident summaries via Gemini API. Without this,
# the app falls back to a template-based summary automatically.
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
